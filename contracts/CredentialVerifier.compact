// Midnight Compact Smart Contract: Confidential Credential Verifier
// Language: Compact (Midnight Network DSL)
//
// Description: Implements privacy-preserving credential issuance, selective disclosure,
// commitment registry, and zero-knowledge claim verification on the Midnight ledger.

pragma language_version >= 0.20.0;

import CompactStandardLibrary;

export enum CredentialType {
    AcademicDegree,
    ProfessionalCertification,
    SecurityClearance,
    IdentityVerification
}

export struct IssuerRecord {
    publicKey: Bytes[32],
    institutionName: String,
    isActive: Boolean,
    issuedCount: Uint<64>
}

export struct PublicVerificationClaim {
    credentialType: CredentialType,
    issuerPublicKey: Bytes[32],
    minCgpaThresholdTimes100: Uint<32>, // e.g., 350 for 3.50 CGPA (scaled to integer)
    minGraduationYear: Uint<32>,
    requireActiveIssuer: Boolean,
    credentialCommitment: Bytes[32]
}

export struct VerificationResult {
    isValid: Boolean,
    verifiedAtTimestamp: Uint<64>,
    claimHash: Bytes[32]
}

// Ledger state accessible publicly on the Midnight blockchain
export ledger {
    // Registry of authorized credential issuers
    issuers: Map<Bytes[32], IssuerRecord>,
    
    // Cryptographic commitments of issued credentials (nullifier/revocation status)
    revokedCommitments: Map<Bytes[32], Boolean>,
    
    // Verification audit trail (public proofs submitted without revealing private witnesses)
    publicVerifications: Map<Bytes[32], VerificationResult>,
    
    // Contract administrator
    contractAdmin: Bytes[32]
}

// Witness state accessible only on the client side in private memory
witness {
    holderSecretKey: Bytes[32],
    fullStudentName: String,
    studentIdNumber: String,
    dateOfBirthTimestamp: Uint<64>,
    exactCgpaTimes100: Uint<32>,
    actualGraduationYear: Uint<32>,
    issuerSignature: Bytes[64],
    credentialBlindingFactor: Bytes[32]
}

// Constructor to initialize verifier
constructor(adminKey: Bytes[32]) {
    contractAdmin = adminKey;
}

// Issuer management circuit
export circuit registerIssuer(
    issuerKey: Bytes[32],
    institutionName: String
): Void {
    // Verify admin permission
    assert(contractAdmin == own_public_key(), "Unauthorized: Admin only");
    
    issuers.insert(issuerKey, IssuerRecord {
        publicKey: issuerKey,
        institutionName: institutionName,
        isActive: true,
        issuedCount: 0
    });
}

// Circuit to record an issued credential commitment
export circuit recordIssuance(
    issuerKey: Bytes[32],
    credentialCommitment: Bytes[32]
): Void {
    // Verifies the caller is the registered issuer
    assert(issuers.member(issuerKey), "Issuer not registered");
    assert(issuers.lookup(issuerKey).isActive, "Issuer is inactive");
    assert(!revokedCommitments.member(credentialCommitment), "Commitment already exists or revoked");

    // Increment issuer issuance counter
    let currentIssuer = issuers.lookup(issuerKey);
    issuers.insert(issuerKey, IssuerRecord {
        publicKey: currentIssuer.publicKey,
        institutionName: currentIssuer.institutionName,
        isActive: currentIssuer.isActive,
        issuedCount: currentIssuer.issuedCount + 1
    });
}

// Zero-Knowledge Selective Disclosure Verification Circuit
// The prover proves:
// 1. They know a valid private credential corresponding to credentialCommitment
// 2. The credential was signed by issuerKey
// 3. exactCgpaTimes100 >= minCgpaThresholdTimes100
// 4. actualGraduationYear >= minGraduationYear
// 5. The credential has not been revoked
// ALL without disclosing fullStudentName, studentIdNumber, dateOfBirth, or exactCgpa.
export circuit verifySelectiveDisclosureProof(
    claim: PublicVerificationClaim
): Boolean {
    // 1. Verify issuer status on public ledger
    if (claim.requireActiveIssuer) {
        assert(issuers.member(claim.issuerPublicKey), "Unknown issuer");
        assert(issuers.lookup(claim.issuerPublicKey).isActive, "Issuer revoked");
    }

    // 2. Verify credential is not revoked on ledger
    assert(!revokedCommitments.lookup(claim.credentialCommitment), "Credential has been revoked");

    // 3. ZK Proof constraints over private witness
    // Reconstruct commitment from private witness attributes:
    let computedCommitment = hash_sha256(
        witness.holderSecretKey,
        witness.fullStudentName,
        witness.studentIdNumber,
        witness.exactCgpaTimes100,
        witness.actualGraduationYear,
        witness.credentialBlindingFactor
    );
    
    assert(computedCommitment == claim.credentialCommitment, "Commitment mismatch: invalid credential witness");

    // 4. Verify cryptographic signature from issuer
    let isValidSig = verify_ed25519_signature(
        claim.issuerPublicKey,
        computedCommitment,
        witness.issuerSignature
    );
    assert(isValidSig, "Invalid issuer signature on private credential");

    // 5. Range checks for selective disclosure claims
    assert(witness.exactCgpaTimes100 >= claim.minCgpaThresholdTimes100, "Claim failed: CGPA requirement not met");
    assert(witness.actualGraduationYear >= claim.minGraduationYear, "Claim failed: Graduation year requirement not met");

    // 6. Record public verification result on ledger without personal data
    let claimHash = hash_sha256(claim.credentialCommitment, claim.issuerPublicKey);
    publicVerifications.insert(claimHash, VerificationResult {
        isValid: true,
        verifiedAtTimestamp: current_timestamp(),
        claimHash: claimHash
    });

    return true;
}
